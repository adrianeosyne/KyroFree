# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# KLIPY GIF search (server-side only). Set this on the Convex deployment:
#   npx convex env set KLIPY_API_KEY <key>
# Never expose this key through a VITE_ variable or the browser bundle.
KLIPY_API_KEY=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Private downloads: set on the Convex deployment, never a VITE_ variable.
# Generate at least 32 cryptographically random characters in your secret manager.
KYRO_FILE_SIGNING_SECRET=

# Optional server-side upload policy (defaults shown).
KYRO_STORAGE_QUOTA_BYTES=262144000
KYRO_UPLOAD_EXTENSIONS=png,jpg,jpeg,gif,webp,mp4,webm,mp3,wav,ogg,m4a,pdf,txt,md,json,csv,docx,xlsx,pptx,zip

# Convex: Ed25519 PKCS8 private key, base64. See npm run bots:webhook-key.
KYRO_BOT_WEBHOOK_PRIVATE_KEY=

# Vercel REST proxy: use the site URL for the same deployment as VITE_CONVEX_URL.
# May be omitted when derivable from the frontend URL.
BOT_CONVEX_SITE_URL=
