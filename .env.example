# Convex deployment URL - replace with your actual deployment URL
# Run 'npx convex dev' to get the development URL
VITE_CONVEX_URL=

# Disable only when temporarily rolling back to a backend without registerUpload.
VITE_CONVEX_UPLOAD_REGISTRATION=true

# KLIPY GIF search (server-side only). Set this on the Convex deployment:
#   npx convex env set KLIPY_API_KEY <key>
# Never expose this key through a VITE_ variable or the browser bundle.
KLIPY_API_KEY=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# Set this in Convex, never in the public Vite environment.
# Only this immutable user ID can approve Premium or grant monthly access.
# KYRO_FOUNDER_USER_ID=your_founder_convex_user_id
# KYRO_PREMIUM_PAYMENT_INSTRUCTIONS=Contact adrianeosyne in Kyro for payment instructions.
