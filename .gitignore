.env.local
node_modules
dist
# src/convex/_generated is committed: offline codegen (npm run gen:convex)
# stands in for `npx convex codegen`, which needs deployment auth.

.vercel
.convex/
test-results/
desktop/release/
.env*
!.env.example

# Windows installers are distributed separately from source control.
/Kyro-Setup-*.exe

# Android build output and local signing material are never source artifacts.
mobile/android/.gradle/
mobile/android/.idea/
mobile/android/**/build/
mobile/android/local.properties
*.jks
*.keystore
*.apk
*.aab

# iOS generated files and Apple signing credentials stay local.
mobile/ios/build/
mobile/ios/DerivedData/
mobile/ios/ExportOptions.local.plist
mobile/ios/**/xcuserdata/
*.xcarchive/
*.ipa
*.p12
*.p8
*.mobileprovision
*.cer
*.keychain-db
